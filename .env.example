# Clearon Environment Variables Template
# Copy this to .env and fill in your actual values

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Python services need SUPABASE_URL (same as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Database Configuration
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AWS Configuration (REQUIRED for file upload)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# Python Microservices
DOCUMENT_PROCESSING_SERVICE_URL=http://localhost:8001
QUERY_PROCESSING_SERVICE_URL=http://localhost:8002

# Authentication Providers (OPTIONAL)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI/ML Configuration (OpenAI Integration)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=512
CHUNK_OVERLAP=102
MAX_RESULTS=5
SIMILARITY_THRESHOLD=0.78
MAX_OUTPUT_TOKENS=500
OPENAI_API_KEY=sk-your-openai-api-key-here

# Development
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001